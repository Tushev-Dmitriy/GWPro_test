      m_Calls: []
  m_text: "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u043A\u043D\u043E\u043F\u043A\u0443
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F \u043D\u0430 3 \u0441\u0435\u043A\u0443\u043D\u0434\u044B,
    \u0447\u0442\u043E\u0431\u044B \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C
    \u0438\u043B\u0438 \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043F\u0440\u0438\u0431\u043E\u0440.\n\u041F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0439\u0442\u0435
    \u0437\u043E\u043D\u0434 \u0432 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435,
    \u0447\u0442\u043E\u0431\u044B \u0438\u0437\u043C\u0435\u0440\u044F\u0442\u044C
    \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u0434\u043E \u043E\u043F\u0430\u0441\u043D\u044B\u0445
    \u0437\u043E\u043D.\n\u0414\u0438\u0441\u043F\u043B\u0435\u0439 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u0434\u043E \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0439
    \u0437\u043E\u043D\u044B \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
    \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u0438 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u043D\u043E\u043C
    \u043F\u0440\u0438\u0431\u043E\u0440\u0435."
